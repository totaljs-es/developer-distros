#!/bin/sh
set -e

[ "$1" = configure ] || exit 0

# The key is the official one: its fingerprint is checked here too, so that a changed file cannot be used by mistake
fpr="$(gpg --show-keys --with-colons /usr/share/keyrings/packages.microsoft.com.asc 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }')"
if [ -n "${fpr}" ] && [ "${fpr}" != BC528686B50D79E339D3721CEB3E94ADBE1229CF ]; then
  echo "totaljs-vscode-source: the key of Microsoft has an unexpected fingerprint (${fpr})" >&2
  exit 1
fi

# The file is not called vscode.sources on purpose: the package code owns that name and its scripts remove it (when an installation of code fails, for one),
# which would leave this system with no source. With any file that already maps to the repository, code does not write its own.
# an earlier build wrote the file with the name that code owns
grep -qs 'packages.microsoft.com.asc' /etc/apt/sources.list.d/vscode.sources && rm -f /etc/apt/sources.list.d/vscode.sources || true
install -m 0644 /usr/share/totaljs-developer/totaljs-vscode.sources /etc/apt/sources.list.d/totaljs-vscode.sources

# The package code adds its own source and key when it is installed: with ours already there, the two would disagree about the key
if [ -e /usr/share/debconf/confmodule ]; then
  . /usr/share/debconf/confmodule
  db_set code/add-microsoft-repo false 2>/dev/null || { echo 'code code/add-microsoft-repo boolean false' | debconf-set-selections 2>/dev/null || true; }
fi

exit 0
