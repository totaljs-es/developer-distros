#!/bin/sh
set -e

[ "$1" = configure ] || exit 0

# Alacritty is the terminal of the desktop: for the programs that open "a terminal" and for PCManFM
update-alternatives --install /usr/bin/x-terminal-emulator x-terminal-emulator /usr/bin/alacritty 60 >/dev/null 2>&1 || true
update-alternatives --set x-terminal-emulator /usr/bin/alacritty >/dev/null 2>&1 || true

# The people that already exist get the configuration of the desktop when they have none (the new ones get it from /etc/skel). What
# a person has is never replaced.
for home in /home/*; do
  [ -d "${home}" ] || continue
  owner="$(stat -c %U "${home}")"
  [ "${owner}" != root ] || continue
  group="$(stat -c %G "${home}")"
  # ~/.config belongs to the person: a root-owned one stops every program of the session from keeping its settings (the wallpaper, the widget, Firefox...).
  # An earlier version of this package left it owned by root, and it is put right here, whether the person has the configuration or not.
  if [ ! -d "${home}/.config" ]; then install -d -o "${owner}" -g "${group}" -m 0755 "${home}/.config"
  elif [ "$(stat -c %U "${home}/.config")" = root ]; then chown "${owner}:${group}" "${home}/.config"; fi
  # the launchers that are hidden in the menu (they do nothing here): every person gets them, whatever configuration they have. Each level of the folder is made by itself, so that it is the person's
  for hidden in /etc/skel/.local/share/applications/*.desktop; do
    [ -e "${hidden}" ] || continue
    for level in "${home}/.local" "${home}/.local/share" "${home}/.local/share/applications"; do
      [ -d "${level}" ] || install -d -o "${owner}" -g "${group}" -m 0755 "${level}"
    done
    [ -e "${home}/.local/share/applications/$(basename "${hidden}")" ] || install -o "${owner}" -g "${group}" -m 0644 "${hidden}" "${home}/.local/share/applications/"
  done
  [ ! -e "${home}/.config/openbox" ] || continue
  for dir in openbox tint2 rofi picom dunst alacritty gsimplecal libfm gtk-3.0 gtk-4.0 autostart; do
    [ ! -e "${home}/.config/${dir}" ] || continue
    [ -e "/etc/skel/.config/${dir}" ] || continue
    cp -a "/etc/skel/.config/${dir}" "${home}/.config/${dir}"
    chown -R "${owner}:${group}" "${home}/.config/${dir}"
  done
done

# The network of the desktop is managed by NetworkManager, as in the desktop of Ubuntu: the icon of the network of the panel talks to it, and with the network of the
# installer (systemd-networkd) it shows "disconnected" although there is internet. It is written only when the package is installed for the first time (a person who
# takes the file out keeps it out), and only when nothing else has chosen NetworkManager. It is not applied now (that would cut the network in the middle of an
# installation or of an SSH session): it takes effect at the next start.
NETPLAN=/etc/netplan/90-totaljs-desktop.yaml
if [ -z "${2:-}" ] && [ -d /etc/netplan ] && [ ! -e "${NETPLAN}" ] && ! grep -qs -E '^[[:space:]]*renderer:[[:space:]]*NetworkManager' /etc/netplan/*.yaml; then
  (
    umask 077
    cat > "${NETPLAN}" <<'EOF'
# The desktop of Total.js Developer lets NetworkManager (the icon of the network in the panel) manage the network, as the desktop of Ubuntu does.
network:
  version: 2
  renderer: NetworkManager
EOF
  )
fi

# The system starts in the graphical session
systemctl set-default graphical.target >/dev/null 2>&1 || true

exit 0
