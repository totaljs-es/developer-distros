#!/bin/sh
set -e

[ "$1" = configure ] || exit 0

# Alacritty is the terminal of the desktop: for the programs that open "a terminal" and for PCManFM
update-alternatives --install /usr/bin/x-terminal-emulator x-terminal-emulator /usr/bin/alacritty 60 >/dev/null 2>&1 || true
update-alternatives --set x-terminal-emulator /usr/bin/alacritty >/dev/null 2>&1 || true

# The people that already exist get the configuration of the desktop when they have none (the new ones get it from /etc/skel). What
# a person has is never replaced.
for home in /home/*; do
  [ -d "${home}" ] || continue
  owner="$(stat -c %U "${home}")"
  [ "${owner}" != root ] || continue
  group="$(stat -c %G "${home}")"
  # ~/.config belongs to the person: a root-owned one stops every program of the session from keeping its settings (the wallpaper, the widget, Firefox...).
  # An earlier version of this package left it owned by root, and it is put right here, whether the person has the configuration or not.
  if [ ! -d "${home}/.config" ]; then install -d -o "${owner}" -g "${group}" -m 0755 "${home}/.config"
  elif [ "$(stat -c %U "${home}/.config")" = root ]; then chown "${owner}:${group}" "${home}/.config"; fi
  [ ! -e "${home}/.config/openbox" ] || continue
  for dir in openbox tint2 rofi picom dunst alacritty gsimplecal libfm gtk-3.0 gtk-4.0 autostart; do
    [ ! -e "${home}/.config/${dir}" ] || continue
    [ -e "/etc/skel/.config/${dir}" ] || continue
    cp -a "/etc/skel/.config/${dir}" "${home}/.config/${dir}"
    chown -R "${owner}:${group}" "${home}/.config/${dir}"
  done
done

# The system starts in the graphical session
systemctl set-default graphical.target >/dev/null 2>&1 || true

exit 0
