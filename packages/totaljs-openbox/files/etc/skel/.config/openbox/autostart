# The session of Total.js Developer. Each line is one thing that starts with Openbox.
xsetroot -cursor_name left_ptr &
# the compositor: GLX where there is 3D, and xrender where there is not
pgrep -u "$(id -u)" -x picom >/dev/null || (
  picom --config "$HOME/.config/picom/picom.conf" --daemon
  sleep 2
  pgrep -u "$(id -u)" -x picom >/dev/null || picom --config "$HOME/.config/picom/picom.conf" --backend xrender --no-vsync --daemon
) &
totaljs-wallpaper &
pgrep -u "$(id -u)" -x tint2 >/dev/null || tint2 -c "$HOME/.config/tint2/tint2rc" &
nm-applet &
pasystray &
# Openbox has no agent of Polkit of its own, and the tools of the desktop that need a password ask for it through one
for agent in /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; do
  if [ -x "$agent" ]; then totaljs-launch-once polkit-gnome-authentication-agent-1 "$agent" & break; fi
done
totaljs-launch-once dunst dunst &
