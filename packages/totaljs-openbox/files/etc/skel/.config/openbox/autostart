# The session of Total.js Developer. Each line is one thing that starts with Openbox.
xsetroot -cursor_name left_ptr &
# the compositor: GLX on a real computer, xrender in a virtual machine or a container (without a real GPU, a GL window such as the
# terminal stays see-through under a GLX compositor, and xrender needs no 3D)
if ! pgrep -u "$(id -u)" -x picom >/dev/null; then
  if systemd-detect-virt --quiet 2>/dev/null; then BACKEND="--backend xrender --no-vsync"; else BACKEND="--backend glx"; fi
  (
    picom --config "$HOME/.config/picom/picom.conf" $BACKEND --daemon
    sleep 2
    pgrep -u "$(id -u)" -x picom >/dev/null || picom --config "$HOME/.config/picom/picom.conf" --backend xrender --no-vsync --daemon
  ) &
fi
totaljs-wallpaper &
# the panel is started again if it ends (a panel that is gone leaves the session without a way to reach anything), and how it ended is kept
pgrep -u "$(id -u)" -x tint2 >/dev/null || (
  mkdir -p "$HOME/.cache"
  while true; do
    tint2 -c "$HOME/.config/tint2/tint2rc"
    echo "$(date +%T) tint2 ended with status $?" >> "$HOME/.cache/tint2-exits.log"
    sleep 2
  done
) &
nm-applet &
pasystray &
# Openbox has no agent of Polkit of its own, and the tools of the desktop that need a password ask for it through one
for agent in /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; do
  if [ -x "$agent" ]; then totaljs-launch-once polkit-gnome-authentication-agent-1 "$agent" & break; fi
done
totaljs-launch-once dunst dunst &
