#!/bin/sh
set -e

[ "$1" = configure ] || exit 0

# The group of the people who develop on this system. /www and the services belong to it, and so does the first person
# of the system, who is the one that the installer created.
getent group totaljs-developer >/dev/null || groupadd --system totaljs-developer

FIRST="$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1; exit }')"
if [ -n "${FIRST}" ]; then
  usermod -aG totaljs-developer "${FIRST}"
fi

exit 0
