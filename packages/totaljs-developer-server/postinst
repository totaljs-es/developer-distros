#!/bin/sh
set -e

[ "$1" = configure ] || exit 0

# The group of the people who develop on this system. /www and the services belong to it.
/usr/lib/totaljs-developer/add-first-user

# On a system that is being installed the person does not exist yet: the first boot adds them
systemctl enable totaljs-developer-first-user.service >/dev/null 2>&1 || true

# In Ubuntu two of the tools have another name (fd is fdfind, bat is batcat): the usual names work
{ [ -e /usr/local/bin/fd ] || [ ! -x /usr/bin/fdfind ] || ln -s /usr/bin/fdfind /usr/local/bin/fd; } || true
{ [ -e /usr/local/bin/bat ] || [ ! -x /usr/bin/batcat ] || ln -s /usr/bin/batcat /usr/local/bin/bat; } || true

# the limits of the files that are watched, now, in a system that is running (at the next start they come from /etc/sysctl.d)
sysctl -p /etc/sysctl.d/90-totaljs-developer.conf >/dev/null 2>&1 || true

exit 0
