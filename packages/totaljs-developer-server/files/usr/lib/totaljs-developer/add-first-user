#!/bin/sh
# Puts the first regular person of the system in the group of the people who develop on it.
#
# It runs when the package is installed and at the first boot after that: an installer creates the person when the system
# starts for the first time (cloud-init), so at install time there may be nobody to add yet. Once it has added somebody it
# does not run again, so a person that was taken out of the group on purpose stays out.
set -eu

MARKER=/var/lib/totaljs-developer/first-user

getent group totaljs-developer >/dev/null || groupadd --system totaljs-developer

[ ! -e "${MARKER}" ] || exit 0

FIRST="$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1; exit }')"
[ -n "${FIRST}" ] || exit 0

usermod -aG totaljs-developer "${FIRST}"
mkdir -p "$(dirname "${MARKER}")"
printf '%s\n' "${FIRST}" > "${MARKER}"
