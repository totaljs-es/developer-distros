[Unit]
Description=Total.js Developer reverse proxy (nginx-proxy)
StartLimitIntervalSec=0
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The first start downloads the images, and the network may not be there yet (a virtual machine that has just been installed, a cable that is not connected):
# the service tries again every 20 seconds, with no limit, until it works
Restart=on-failure
RestartSec=20
WorkingDirectory=/www/proxy
# the network that every service joins, so that the proxy can reach it
ExecStartPre=-/usr/bin/docker network create proxy
# the first start downloads the images: it can take a while
TimeoutStartSec=1800
ExecStart=/usr/bin/docker compose -f docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml down --timeout 10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
