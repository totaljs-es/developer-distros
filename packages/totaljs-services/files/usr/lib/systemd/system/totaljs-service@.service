[Unit]
Description=Total.js service %i
Requires=docker.service
Wants=totaljs-proxy.service
StartLimitIntervalSec=0
After=docker.service network-online.target totaljs-proxy.service
Wants=network-online.target
ConditionPathExists=/www/services/%i/docker-compose.yml

[Service]
Type=oneshot
RemainAfterExit=yes
# Same as the other services: the first start downloads the images and may happen before the network is there, so it tries again until it works
Restart=on-failure
RestartSec=20
WorkingDirectory=/www/services/%i
TimeoutStartSec=1800
ExecStart=/usr/bin/docker compose -f docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml down --timeout 10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
