#!/bin/sh
set -e

[ "$1" = configure ] || exit 0

systemctl daemon-reload >/dev/null 2>&1 || true
systemctl enable totaljs-dns.service >/dev/null 2>&1 || true

# On a system that is already running, start it and tell systemd-resolved about the new configuration
if [ -d /run/systemd/system ]; then
  systemctl restart totaljs-dns.service >/dev/null 2>&1 || true
  systemctl restart systemd-resolved.service >/dev/null 2>&1 || true
fi

exit 0
