[Unit]
Description=Total.js Developer local domain DNS
# No ordering with network.target or systemd-resolved: a service that is after the basic system and before systemd-resolved makes a cycle (systemd-resolved is
# part of sysinit.target), and systemd drops a job to break it. dnsmasq listens on the loopback, and systemd-resolved asks it when it is there.
# if dnsmasq is not there, or the configuration is wrong, it is better to say so than to start and answer nothing
ConditionFileIsExecutable=/usr/sbin/dnsmasq

[Service]
Type=simple
ExecStartPre=/usr/sbin/dnsmasq --test --conf-file=/etc/totaljs-developer/dns.conf
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/totaljs-developer/dns.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
