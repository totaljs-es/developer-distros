#!/bin/sh
set -e

[ "$1" = configure ] || exit 0

# its own user, with no shell and in no group: the services are read through systemd, not through Docker
getent passwd totalcenter >/dev/null || useradd --system --user-group --home-dir /var/lib/totaljs-center --no-create-home --shell /usr/sbin/nologin totalcenter >/dev/null

/usr/lib/totaljs-developer/center-sync
systemctl daemon-reload >/dev/null 2>&1 || true
systemctl enable totaljs-center.service >/dev/null 2>&1 || true
if [ -d /run/systemd/system ]; then systemctl restart totaljs-center.service >/dev/null 2>&1 || true; fi

exit 0
