# Live-image dependency only; this is not part of the installed Total.js layer.
pkgname=calamares
pkgver=3.3.14
pkgrel=1
pkgdesc='Distribution independent installer framework for the Total.js live medium'
arch=('x86_64' 'aarch64')
url='https://calamares.io'
license=('GPL-3.0-or-later')
depends=('qt6-base>=6.7' 'qt6-declarative' 'qt6-svg' 'yaml-cpp' 'kcoreaddons'
         'kconfig' 'ki18n' 'kservice' 'kpmcore' 'polkit-qt6' 'python'
         'libpwquality' 'icu' 'parted' 'libxcrypt')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools')
source=("https://github.com/calamares/calamares/releases/download/v${pkgver}/calamares-${pkgver}.tar.gz")
sha256sums=('5547f80db067dea923ae693ba6bb88eb2b2eeac1da3ebec42fce453e31c290c0')

build() {
    # Build the modules used by the shared profile; fail at live setup if any
    # required runtime module is absent. Avoid unrelated desktop integrations.
    local module skipped=''
    local selected=' welcome locale keyboard packagechooser partition users summary finished mount machineid fstab localecfg networkcfg hwclock bootloader umount '
    for module in "${srcdir}/calamares-${pkgver}/src/modules/"*; do
        [ -d "${module}" ] || continue
        case "${selected}" in *" ${module##*/} "*) ;; *) skipped+="${module##*/};" ;; esac
    done
    cmake -S "calamares-${pkgver}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release -DWITH_QT6=ON -DWITH_PYTHON=ON \
        -DWITH_QML=ON -DWITH_PYBIND11=ON -DBUILD_TESTING=OFF \
        -DBUILD_SCHEMA_TESTING=OFF -DBUILD_CRASH_REPORTING=OFF \
        -DBUILD_APPDATA=OFF -DBUILD_APPSTREAM=OFF -DINSTALL_CONFIG=OFF \
        -DSKIP_MODULES="${skipped}"
    cmake --build build --parallel "${CALAMARES_BUILD_JOBS:-2}"
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
}
